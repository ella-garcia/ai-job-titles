# Copy to .env (make setup does this). .env is git-ignored; never commit it.
# Every setting is optional: the defaults reproduce the results once `make snapshots` has copied the
# data branch into ./data.

# Where the data lives (default ./data). Change it only to keep the data elsewhere, e.g. a synced
# Google Drive folder:
# AJT_DATA=~/Library/CloudStorage/GoogleDrive-<you>@gmail.com/My Drive/ai-job-titles-data
AJT_DATA=./data

# Hacker News from BigQuery instead of the Hugging Face copy (the HN extract is already on the data
# branch). Any Google Cloud project with BigQuery enabled; the free tier is enough.
# Also run once: gcloud auth application-default login
GCP_PROJECT=

# Kaggle step only. Your own token: kaggle.com -> Settings -> API -> Create New Token. Never share it.
KAGGLE_USERNAME=
KAGGLE_KEY=
