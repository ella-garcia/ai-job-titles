# Copy to .env and fill in. .env is git-ignored; never commit it.

# Where the data lives. Point both laptops at the same synced folder, e.g. a shared
# Google Drive folder via Google Drive for desktop:
# AJT_DATA=~/Library/CloudStorage/GoogleDrive-<you>@gmail.com/My Drive/ai-job-titles-data
AJT_DATA=./data

# BigQuery (HN extract). Any Google Cloud project with BigQuery enabled; free tier is enough.
# Also run once: gcloud auth application-default login
GCP_PROJECT=

# Kaggle API (kaggle.com -> Settings -> API -> Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=
